+
+void freeink::FreeInkDisplay::beginCheckedRefresh() {
+  syncPendingAsync();
+  _bus.clearWaitFailure();
+}
+
+freeink::FreeInkDisplay::RefreshResult freeink::FreeInkDisplay::endCheckedRefresh() {
+  syncPendingAsync();
+  _bus.endCheckedWait();
+  if (!_driver || !frameBuffer || _buildLent || !_driver->displayCommitted()) return RefreshResult::Unavailable;
+  if (_bus.waitFailed()) {
+    _driver->requestResync(1);
+    return RefreshResult::Timeout;
+  }
+  return RefreshResult::Complete;
+}
